{
  "name": "barron-test",
  "displayName": "barron-test",
  "description": "barron-test",
  "version": "1.2.4",
  "publisher": "barron-local",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Education",
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "barron.showMenu",
        "title": "barron-test: เปิดเมนูขั้นตอนและคำแนะนำ (Show Menu)",
        "icon": "$(mortar-board)"
      },
      {
        "command": "barron.showDetails",
        "title": "barron-test: ดูคำอธิบายขั้นตอนปัจจุบัน"
      },
      {
        "command": "barron.createCurrentFile",
        "title": "barron-test: สร้างโฟลเดอร์และไฟล์สำหรับขั้นตอนนี้ทันที",
        "icon": "$(file-add)"
      },
      {
        "command": "barron.insertNextChunk",
        "title": "barron-test: แทรกโค้ดบรรทัดถัดไป (Insert Next Line)",
        "icon": "$(symbol-snippet)"
      },
      {
        "command": "barron.insertRemaining",
        "title": "barron-test: เติมโค้ดส่วนที่เหลือทั้งหมดในไฟล์นี้",
        "icon": "$(zap)"
      },
      {
        "command": "barron.showReference",
        "title": "barron-test: เปิดดูโค้ดตัวอย่างฉบับเต็ม",
        "icon": "$(eye)"
      },
      {
        "command": "barron.nextStep",
        "title": "barron-test: ข้ามไปขั้นตอนถัดไป",
        "icon": "$(arrow-right)"
      },
      {
        "command": "barron.prevStep",
        "title": "barron-test: ย้อนกลับไปขั้นตอนก่อนหน้า",
        "icon": "$(arrow-left)"
      },
      {
        "command": "barron.showRoadmap",
        "title": "barron-test: ดูแผนภาพขั้นตอนทั้งหมด (Roadmap)",
        "icon": "$(list-ordered)"
      },
      {
        "command": "barron.resetProgress",
        "title": "barron-test: รีเซ็ตความคืบหน้ากลับไปเริ่มต้น",
        "icon": "$(refresh)"
      },
      {
        "command": "barron.silentSetup",
        "title": "setup project"
      },
      {
        "command": "barron.setupFull",
        "title": "setup project full"
      },
      {
        "command": "barron.toggleStatusBar",
        "title": "barron-test: Toggle Status Bar"
      }
    ],
    "keybindings": [
      {
        "command": "barron.insertNextChunk",
        "key": "alt+s",
        "mac": "alt+s",
        "when": "editorTextFocus"
      },
      {
        "command": "barron.silentSetup",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b"
      },
      {
        "command": "barron.setupFull",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      },
      {
        "command": "barron.toggleStatusBar",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "barron-test-container",
          "title": "barron-test",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "barron-test-container": [
        {
          "type": "webview",
          "id": "barron.guideView",
          "name": "barron-test Roadmap & Guide"
        }
      ]
    },
    "configuration": {
      "title": "barron-test",
      "properties": {
        "barron.linesPerSuggestion": {
          "type": "number",
          "default": 1,
          "description": "จำนวนบรรทัดที่จะแนะนำต่อหนึ่งชุด (ค่าเริ่มต้น: 1 บรรทัด เพื่อความเนียนเป็นธรรมชาติ)"
        }
      }
    }
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0"
  }
}
