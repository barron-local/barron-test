{
    local_certs
    auto_https disable_redirects
}

http://backend.mydomain.lab, https://backend.mydomain.lab {
    reverse_proxy app:5000
}

http://frontend.mydomain.lab, https://frontend.mydomain.lab {
    handle /docs* {
        reverse_proxy app:5000
    }
    handle /api/docs* {
        reverse_proxy app:5000
    }
    reverse_proxy frontend:3000
}

http://gitlab.mydomain.lab, https://gitlab.mydomain.lab {
    reverse_proxy gitlab:80
}

http://registry.mydomain.lab, https://registry.mydomain.lab {
    reverse_proxy gitlab:5050
}

:80, :443 {
    handle /docs* {
        reverse_proxy app:5000
    }
    handle /api/docs* {
        reverse_proxy app:5000
    }
    handle /api/* {
        reverse_proxy app:5000
    }
    handle /uploads/* {
        reverse_proxy app:5000
    }
    reverse_proxy frontend:3000
}
