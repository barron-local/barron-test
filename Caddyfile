{
    local_certs
    auto_https disable_redirects
}

http://backend.group3.vec, https://backend.group3.vec {
    reverse_proxy app:5000
}

http://frontend.group3.vec, https://frontend.group3.vec {
    reverse_proxy frontend:3000
}

http://gitlab.group3.vec, https://gitlab.group3.vec {
    reverse_proxy gitlab:80
}

http://registry.group3.vec, https://registry.group3.vec {
    reverse_proxy gitlab:5050
}
