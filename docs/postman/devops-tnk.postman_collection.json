    {
      "name": "03. ส่งข้อมูล POST Requests (เกณฑ์ 4.5.2, 4.5.5)",
      "description": "ทดสอบส่ง JSON Body บันทึกข้อมูลลง MySQL และทดสอบ Error Handling",
      "item": [
        {
          "name": "3.1 เพิ่มผู้ใช้ใหม่สำเร็จ (POST /api/users)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code 201 Created: บันทึกข้อมูลสำเร็จ', function () {",
                  "    pm.response.to.have.status(201);",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.status).to.eql('success');",
                  "    if (res.data && res.data.id) {",
                  "        pm.environment.set('new_user_id', res.data.id);",
                  "        pm.collectionVariables.set('new_user_id', res.data.id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student_demo\",\n  \"password\": \"password123\",\n  \"role\": \"readonly\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "เกณฑ์ 4.5.2: ส่งข้อมูล JSON ผ่าน Body และบันทึกลงฐานข้อมูลถูกต้อง"
          }
        },
