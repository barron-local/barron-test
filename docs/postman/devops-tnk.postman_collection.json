  "item": [
    {
      "name": "01. เข้าสู่ระบบ & ความปลอดภัย (เกณฑ์ 4.5.4, 4.5.10)",
      "description": "ทดสอบ API Login ออก JWT Token พร้อมลายเซ็น (Signing) และการออกจากระบบ",
      "item": [
        {
          "name": "1.1 Login ด้วย Admin (บันทึก Token อัตโนมัติ)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code 200: เข้าสู่ระบบสำเร็จ', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response มีสถานะ success และได้รับ JWT Token', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('success');",
                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "    pm.environment.set('token', jsonData.token);",
                  "    pm.environment.set('admin_token', jsonData.token);",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    pm.collectionVariables.set('admin_token', jsonData.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "description": "เกณฑ์ 4.5.4: เรียก API Login ด้วย username/password แล้วได้รับ JWT Token สำหรับใช้ยืนยันตัวตน"
          }
        },
