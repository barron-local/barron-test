              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created: บันทึกข้อมูลสำเร็จ', function () { pm.response.to.have.status(201); });",
                  "pm.test('เกณฑ์ 4.5.6: Response มี status: success และบันทึก ID ใหม่', function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.status).to.eql('success');",
                  "    if (res.data && res.data.id) {",
                  "        pm.environment.set('new_user_id', res.data.id);",
                  "        pm.collectionVariables.set('new_user_id', res.data.id);",
                  "    }",
