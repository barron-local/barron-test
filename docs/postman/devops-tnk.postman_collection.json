    {
      "name": "[เกณฑ์ 4.5.1] API แบบ GET (Query & Path Parameters)",
      "description": "เกณฑ์ 4.5.1: สร้าง API แบบ GET พร้อมรับค่า (Query หรือ Path Parameters) ผลลัพธ์ต้องเปลี่ยนตามค่าพารามิเตอร์ที่ส่ง",
      "item": [
        {
          "name": "2.1 ดึงรายชื่อทั้งหมด (GET /api/users)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200: ดึงข้อมูลสำเร็จ', function () { pm.response.to.have.status(200); });",
                  "pm.test('เกณฑ์ 4.5.6: Response มี status, message, data ครบ', function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res).to.have.property('status');",
                  "    pm.expect(res).to.have.property('message');",
                  "    pm.expect(res).to.have.property('data');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
