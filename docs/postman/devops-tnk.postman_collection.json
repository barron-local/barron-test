              "path": [
                "api",
                "users"
              ],
              "query": [
                {
                  "key": "state",
                  "value": "on"
                }
              ]
            }
          }
        },
        {
          "name": "2.5 ดึงข้อมูลรายบุคคลด้วย Path Parameter (GET /api/users/1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code 200: ดึงข้อมูล ID 1 สำเร็จ', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.data.id).to.eql(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
