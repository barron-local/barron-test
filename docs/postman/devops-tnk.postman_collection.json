            ],
            "url": {
              "raw": "{{base_url}}/api/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          }
        },
        {
          "name": "2.2 ค้นหาด้วย Query Parameter: search (?search=admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200: ค้นหาสำเร็จ', function () { pm.response.to.have.status(200); });",
                  "pm.test('เกณฑ์ 4.5.1: ผลลัพธ์กรองเปลี่ยนตาม search=admin', function () {",
                  "    var res = pm.response.json();",
                  "    var list = res.data.users || res.data;",
                  "    pm.expect(list.some(u => u.username === 'admin')).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users?search=admin",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "admin"
                }
              ]
            },
            "description": "เกณฑ์ 4.5.1: ผลลัพธ์เปลี่ยนตาม Query String"
          }
        },
