    {
      "name": "[เกณฑ์ 4.5.4 & 4.4.5] API Login ด้วย JWT Token (ออก Token & มีลายเซ็น)",
      "description": "เกณฑ์ 4.5.4: เรียก API Login ด้วย Username/Password แล้วตรวจสอบ Token ที่ได้รับ และเกณฑ์ 4.4.5 แนวทางความปลอดภัย",
      "item": [
        {
          "name": "1.1 Login ด้วย Admin (บันทึก Token อัตโนมัติ)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code 200: Login สำเร็จ', function () { pm.response.to.have.status(200); });",
                  "pm.test('ได้รับ JWT Token พร้อมใช้งาน', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('success');",
                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "    pm.environment.set('token', jsonData.token);",
                  "    pm.environment.set('admin_token', jsonData.token);",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    pm.collectionVariables.set('admin_token', jsonData.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "description": "เกณฑ์ 4.5.4: Login สำเร็จ ได้รับ JWT Token"
