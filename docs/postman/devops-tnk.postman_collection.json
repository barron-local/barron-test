    {
      "name": "04. อัปโหลดไฟล์ File Upload (เกณฑ์ 4.5.3)",
      "description": "ทดสอบส่งไฟล์แบบ multipart/form-data และเปิดดูไฟล์ได้จริง",
      "item": [
        {
          "name": "4.1 อัปโหลดไฟล์ประจำตัวผู้ใช้ (POST /api/users/:id/upload)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code 200: อัปโหลดสำเร็จ', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.status).to.eql('success');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/users/1/upload",
              "host": [
                "{{base_url}}"
