    {
      "name": "02. ดึงข้อมูล GET Requests (เกณฑ์ 4.5.1, 4.5.6)",
      "description": "ทดสอบ API GET รองรับ Query Parameters และ Path Parameters ผลลัพธ์เปลี่ยนตามค่าที่ส่ง",
      "item": [
        {
          "name": "2.1 ดึงรายชื่อผู้ใช้ทั้งหมด (GET /api/users)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('โครงสร้างข้อมูลมี status, message, data ตามเกณฑ์ 4.5.6', function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res).to.have.property('status');",
                  "    pm.expect(res).to.have.property('message');",
                  "    pm.expect(res).to.have.property('data');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          }
        },
        {
          "name": "2.2 ค้นหาด้วย Query: search (GET /api/users?search=admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('ผลลัพธ์ตรงกับคำค้นหา admin', function () {",
                  "    var res = pm.response.json();",
                  "    var list = res.data.users || res.data;",
                  "    pm.expect(list.some(u => u.username === 'admin')).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users?search=admin",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "admin"
                }
              ]
            },
            "description": "เกณฑ์ 4.5.1: ผลลัพธ์เปลี่ยนตามค่า Query Parameter"
          }
        },
        {
          "name": "2.3 กรองด้วย Query: role (GET /api/users?role=readonly)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
