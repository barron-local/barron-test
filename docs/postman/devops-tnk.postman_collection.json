              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users?role=readonly",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "readonly"
                }
              ]
            }
          }
        },
        {
          "name": "2.4 กรองด้วย Query: state (GET /api/users?state=on)",
